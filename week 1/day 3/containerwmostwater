#include <bits/stdc++.h>
using namespace std;

int maxArea(vector<int>& height) {
    int maxi = 0;
    int n = height.size();

    int l = 0;
    int r = n - 1;

    while (l < r) {
        int width = r - l;
        int h = min(height[l], height[r]);
        int water = width * h;

        maxi = max(maxi, water);

        if (height[l] < height[r]) {
            l++;
        } else {
            r--;
        }
    }

    return maxi;
}

int main() {
    int n;
    cin >> n;

    vector<int> height(n);

    for (int i = 0; i < n; i++) {
        cin >> height[i];
    }

    cout << maxArea(height);

    return 0;
}